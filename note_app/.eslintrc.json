{
  "root": true,
  "ignorePatterns": [
    "projects/**/*"
  ],
  "overrides": [
    {
      "files": [
        "*.ts"
      ],
      "extends": [
        "eslint:recommended"
      ],
      "rules": {
        "no-unused-vars": ["error", { 
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "args": "none"
        }]
      }
    }
  ]
}
